    "This will delete all legacy schedules. Schedules created by myHotTub will remain intact. This action cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي ذلك إلى حذف جميع الجداول القديمة. ستبقى الجداول الزمنية التي تم إنشاؤها بواسطة myHotTub سليمة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Legacy-Zeitpläne gelöscht. Von myHotTub erstellte Zeitpläne bleiben intakt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete all legacy schedules. Schedules created by myHotTub will remain intact. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todos los horarios heredados. Los horarios creados por myHotTub permanecerán intactos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera tous les calendriers hérités. Les horaires créés par myHotTub resteront intacts. Cette action ne peut pas être défaite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सभी विरासत शेड्यूल को हटा देगा। myHotTub द्वारा बनाए गए शेड्यूल बरकरार रहेंगे। इस क्रिया को पूर्ववत नहीं किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua jadwal lama. Jadwal yang dibuat oleh myHotTub akan tetap utuh. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà tutti i programmi legacy. Gli orari creati da myHotTub rimarranno intatti. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、すべてのレガシースケジュールが削除されます。 myHotTubによって作成されたスケジュールはそのまま残ります。 このアクションは元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 모든 레거시 일정이 삭제됩니다. myHotTub에서 만든 일정은 그대로 유지됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle verouderde schema's verwijderd. Schema's gemaakt door myHotTub blijven intact. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie wszystkich starszych harmonogramów. Harmonogramy utworzone przez myHotTub pozostaną nienaruszone. This action cannot be unone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá todos os cronogramas legados. Os horários criados pelo myHotTub permanecerão intactos. Esta ação não pode ser desfeita."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งนี้จะลบกําหนดการเดิมทั้งหมด ตารางเวลาที่สร้างโดย myHotTub จะยังคงเหมือนเดิม การดําเนินการนี้ไม่สามารถยกเลิกได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, tüm eski programları siler. myHotTub tarafından oluşturulan programlar bozulmadan kalacaktır. Bu eylem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa tất cả các lịch trình kế thừa. Lịch trình được tạo bởi myHotTub sẽ vẫn còn nguyên vẹn. Hành động này không thể hoàn tác được."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將刪除所有遺留時間表。 myHotTub建立的時間表將保持不變。 這一行動無法撤銷。"
          }
        }
      }
    },
