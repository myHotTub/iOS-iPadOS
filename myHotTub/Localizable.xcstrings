    "Add a schedule to keep your Hot Tub warm and ready when you are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف جدولا زمنيا للحفاظ على حوض الاستحمام الساخن دافئا وجاهزا عندما تكون كذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie einen Zeitplan hinzu, um Ihren Whirlpool warm und bereit zu halten, wenn Sie es sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a schedule to keep your Hot Tub warm and ready when you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue un horario para mantener su bañera de hidromasaje caliente y lista cuando lo esté."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un horaire pour garder votre bain à remous au chaud et prêt quand vous l'êtes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप हों तो अपने हॉट टब को गर्म और तैयार रखने के लिए एक शेड्यूल जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan jadwal untuk menjaga Bak Mandi Air Panas Anda tetap hangat dan siap saat Anda berada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un programma per mantenere la tua vasca idromassaggio calda e pronta quando lo sei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットタブを暖かく保ち、いつでも準備を整えるためのスケジュールを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 있을 때 온수 욕조를 따뜻하게 유지하고 준비할 수 있도록 일정을 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een schema toe om uw hot tub warm en klaar te houden wanneer u dat bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj harmonogram, aby Twoja wanna z hydromasażem była ciepła i gotowa, gdy jesteś."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um cronograma para manter sua banheira de hidromassagem aquecida e pronta quando você estiver."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มตารางเวลาเพื่อให้อ่างน้ําร้อนของคุณอบอุ่นและพร้อมเมื่อคุณอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcak Küvetinizi sıcak tutmak için bir program ekleyin ve hazır olduğunuzda hazır olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một lịch trình để giữ cho Bồn tắm nước nóng của bạn ấm áp và sẵn sàng khi bạn sẵn sàng."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增一個時間表，讓你的熱水浴缸保持溫暖，並在你準備好的時候。"
          }
        }
      }
    },
