    "We couldn’t connect to your ESP8266 module. Please check your Wi-Fi setup and ensure the module is powered on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم نتمكن من الاتصال بوحدة ESP8266 الخاصة بك. يرجى التحقق من إعداد Wi-Fi والتأكد من تشغيل الوحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten keine Verbindung zu Ihrem ESP8266-Modul herstellen. Bitte überprüfen Sie Ihr WLAN-Setup und stellen Sie sicher, dass das Modul eingeschaltet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We could not connect to your ESP8266 module. Please check your Wi-Fi setup and ensure the module is powered on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos conectarnos a su módulo ESP8266. Por favor, compruebe su configuración de Wi-Fi y asegúrese de que el módulo esté encendido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'avons pas pu nous connecter à votre module ESP8266. Veuillez vérifier votre configuration Wi-Fi et vous assurer que le module est allumé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपके ESP8266 मॉड्यूल से कनेक्ट नहीं हो सके। कृपया अपने वाई-फाई सेटअप की जांच करें और सुनिश्चित करें कि मॉड्यूल चालू है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat terhubung ke modul ESP8266 Anda. Silakan periksa pengaturan Wi-Fi Anda dan pastikan modulnya menyala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a connetterci al tuo modulo ESP8266. Controlla la configurazione del Wi-Fi e assicurati che il modulo sia acceso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP8266モジュールに接続できませんでした。 Wi-Fi の設定を確認し、モジュールの電源が入っていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP8266 모듈에 연결할 수 없습니다. Wi-Fi 설정을 확인하고 모듈의 전원이 켜져 있는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden geen verbinding maken met uw ESP8266-module. Controleer uw wifi-configuratie en zorg ervoor dat de module is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie mogliśmy połączyć się z Twoim modułem ESP8266. Please check your Wi-Fi setup and ensure the module is powered on."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos nos conectar ao seu módulo ESP8266. Verifique sua configuração de Wi-Fi e certifique-se de que o módulo esteja ligado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราไม่สามารถเชื่อมต่อกับโมดูล ESP8266 ของคุณได้ โปรดตรวจสอบการตั้งค่า Wi-Fi ของคุณและตรวจสอบให้แน่ใจว่าโมดูลเปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP8266 modülünüze bağlanamadık. Lütfen Wi-Fi kurulumunuzu kontrol edin ve modülün açık olduğundan emin olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi không thể kết nối với mô-đun ESP8266 của bạn. Vui lòng kiểm tra thiết lập Wi-Fi của bạn và đảm bảo rằng mô-đun đã được bật nguồn."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們無法連線到您的ESP8266模組。 請檢查您的Wi-Fi設定，並確保模組已開機。"
          }
        }
      }
    },
